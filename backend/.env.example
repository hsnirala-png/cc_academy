# For VPS/production: keep values in .env
# For local development: create .env.local (it overrides .env)
DATABASE_URL="mysql://cc_user:password%40encoded@127.0.0.1:3306/cc_academy"
SHADOW_DATABASE_URL="mysql://cc_user:password%40encoded@127.0.0.1:3306/prisma_shadow"
JWT_SECRET="change_me"
PORT=5000
MAINTENANCE=false
OPENAI_API_KEY=""
OPENAI_TRANSLATION_MODEL="gpt-4o-mini"
LESSON_AI_PROVIDER="mock"
OPENAI_LESSON_AI_MODEL="gpt-4o-mini"
OPENAI_REALTIME_MODEL="gpt-realtime"
OPENAI_REALTIME_VOICE="marin"
GEMINI_API_KEY=""
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
GEMINI_TTS_VOICE="Kore"
PUNJABI_TRANSLITERATION_URL="http://127.0.0.1:8091/transliterate/punjabi"
HINDI_TRANSLITERATION_URL="http://127.0.0.1:8091/transliterate/hindi"
# Optional absolute path to a persistent public assets directory for uploads.
# Use a path outside the frontend deploy folder so admin uploads survive future deployments.
# Example (Linux VPS): /var/lib/cc_academy/public
PUBLIC_ASSETS_DIR=""
